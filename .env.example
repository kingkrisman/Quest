# Supabase project used for live multiplayer games (lobbies, answers, scores).
# The anon key is safe to expose in the browser; protect data with row-level security.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Port for `npm start` (production server). Defaults to 3000.
PORT=3000
